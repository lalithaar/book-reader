{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Book Reader",
  "version": "0.1.0",
  "identifier": "dev.bookreader.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Book Reader",
        "width": 1080,
        "height": 800,
        "minWidth": 460,
        "minHeight": 360,
        "center": true,
        "backgroundColor": "#12100e",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
